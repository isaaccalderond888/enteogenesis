# Copy to .env.local for local work.
# On Vercel: Project → Settings → Environment Variables.

# Postgres (Neon). Required in production so fichas and sessions persist.
DATABASE_URL=

# Auth
VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
# Public origin of the live app, no trailing slash. Example: https://enteogenesis.app
BETTER_AUTH_URL=

# Optional — Google sign-in for staff
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
